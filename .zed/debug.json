{
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Express Server",
      "program": "${workspaceRoot}/app.js",
      "cwd": "${workspaceRoot}",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--inspect"],
      "console": "integratedTerminal"
    }
  ]
}